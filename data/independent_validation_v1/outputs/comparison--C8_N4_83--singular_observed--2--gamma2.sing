LIB "primdec.lib";
ring r=0,(c(1..8)),dp;
option(redSB);
ideal I=(1/256)*c(1)+(1/64)*c(8)-(-3/32768),
(1/192)*c(2)+(1/96)*c(3)-(0),
(1/32)*c(4)+(1/64)*c(5)-(3/16384),
(1/128)*c(6)+(1/32)*c(7)-(-5/8192),
(1/256)*c(1)+(1/192)*c(2)-(11/98304),
(1/96)*c(3)+(1/32)*c(4)-(-11/24576),
(1/64)*c(5)+(1/128)*c(6)-(15/16384),
(1/32)*c(7)+(1/64)*c(8)-(-9/8192),
c(1)*c(3)*c(5)*c(7)-c(2)*c(4)*c(6)*c(8),
c(1)^2+c(2)^2+c(3)^2+c(4)^2+c(5)^2+c(6)^2+c(7)^2+c(8)^2-(163/32768);
ideal B=std(I);
print("RAW_DIM|"+string(dim(B)));
print("RAW_VDIM|"+string(vdim(B)));
ideal R=std(radical(I));
int pointCount=vdim(R);
ring s=0,(c(1..8),zz),lp;
ideal J=imap(r,R);
J[size(J)+1]=zz-((1)*c(1)+(2)*c(2)+(4)*c(3)+(8)*c(4)+(16)*c(5)+(32)*c(6)+(64)*c(7)+(128)*c(8));
ideal G=std(J);
print("POINT_COUNT|"+string(pointCount));
print("BEGIN_BASIS");
print("DIM|"+string(dim(G)));
print("VDIM|"+string(vdim(G)));
int i; poly p;
for(i=1;i<=size(G);i++){
 print("POLY"); p=G[i];
 while(p!=0){ print("TERM|"+string(leadcoef(p))+"|"+string(leadexp(p))); p=p-lead(p); }
}
print("END_BASIS");
list FF=factorize(G[1]);
ideal factors=FF[1]; intvec powers=FF[2];
print("BEGIN_FACTORS");
for(i=1;i<=size(factors);i++){
 if(deg(factors[i])>0){
  print("FACTOR|"+string(powers[i])); p=factors[i];
  while(p!=0){ print("TERM|"+string(leadcoef(p))+"|"+string(leadexp(p))); p=p-lead(p); }
 }
}
print("END_FACTORS");
quit;
