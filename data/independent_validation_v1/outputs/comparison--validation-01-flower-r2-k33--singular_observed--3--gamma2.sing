LIB "primdec.lib";
ring r=0,(c(1..12)),dp;
option(redSB);
ideal I=(1/756)*c(1)+(1/1890)*c(6)+(1/1134)*c(7)+(1/3024)*c(12)-(1457/1393459200),
(1/756)*c(2)+(1/1134)*c(3)-(11/5160960),
(1/378)*c(4)+(1/630)*c(5)-(-143/38707200),
(1/504)*c(8)+(1/1008)*c(9)-(-5/1032192),
(1/1764)*c(10)+(1/2352)*c(11)-(-89/54190080),
(1/756)*c(1)+(1/756)*c(2)-(19/9289728),
(1/1134)*c(3)+(1/378)*c(4)-(-1/110592),
(1/630)*c(5)+(1/1890)*c(6)-(341/58060800),
(1/1134)*c(7)+(1/504)*c(8)-(-2299/557383680),
(1/1008)*c(9)+(1/1764)*c(10)-(-239/433520640),
(1/2352)*c(11)+(1/3024)*c(12)-(-29/24084480),
c(1)*c(3)*c(5)-c(2)*c(4)*c(6),
c(7)*c(9)*c(11)-c(8)*c(10)*c(12),
c(1)^2+c(2)^2+c(3)^2+c(4)^2+c(5)^2+c(6)^2+c(7)^2+c(8)^2+c(9)^2+c(10)^2+c(11)^2+c(12)^2-(153893/3019898880);
ideal B=std(I);
print("RAW_DIM|"+string(dim(B)));
print("RAW_VDIM|"+string(vdim(B)));
ideal R=std(radical(I));
int pointCount=vdim(R);
ring s=0,(c(1..12),zz),lp;
ideal J=imap(r,R);
J[size(J)+1]=zz-((1)*c(1)+(2)*c(2)+(4)*c(3)+(8)*c(4)+(16)*c(5)+(32)*c(6)+(64)*c(7)+(128)*c(8)+(256)*c(9)+(512)*c(10)+(1024)*c(11)+(2048)*c(12));
ideal G=std(J);
print("POINT_COUNT|"+string(pointCount));
print("BEGIN_BASIS");
print("DIM|"+string(dim(G)));
print("VDIM|"+string(vdim(G)));
int i; poly p;
for(i=1;i<=size(G);i++){
 print("POLY"); p=G[i];
 while(p!=0){ print("TERM|"+string(leadcoef(p))+"|"+string(leadexp(p))); p=p-lead(p); }
}
print("END_BASIS");
list FF=factorize(G[1]);
ideal factors=FF[1]; intvec powers=FF[2];
print("BEGIN_FACTORS");
for(i=1;i<=size(factors);i++){
 if(deg(factors[i])>0){
  print("FACTOR|"+string(powers[i])); p=factors[i];
  while(p!=0){ print("TERM|"+string(leadcoef(p))+"|"+string(leadexp(p))); p=p-lead(p); }
 }
}
print("END_FACTORS");
quit;
