LIB "primdec.lib";
ring r=0,(c(1..20)),dp;
option(redSB);
ideal I=(1/1980)*c(1)+(1/3960)*c(10)+(1/4950)*c(11)+(1/2970)*c(20)-(-89/273715200),
(1/1760)*c(2)+(1/6160)*c(3)-(13/412876800),
(1/6930)*c(4)+(1/4950)*c(5)-(-127/851558400),
(1/2200)*c(6)+(1/440)*c(7)-(267/90112000),
(1/770)*c(8)+(1/3080)*c(9)-(-109/45416448),
(1/4950)*c(12)+(1/6930)*c(13)-(-1/13305600),
(1/4620)*c(14)+(1/4620)*c(15)-(-17/81100800),
(1/3850)*c(16)+(1/3300)*c(17)-(1/16128000),
(1/1320)*c(18)+(1/660)*c(19)-(-1/162201600),
(1/1980)*c(1)+(1/1760)*c(2)-(1589/5839257600),
(1/6160)*c(3)+(1/6930)*c(4)-(1/54067200),
(1/4950)*c(5)+(1/2200)*c(6)-(-3131/2433024000),
(1/440)*c(7)+(1/770)*c(8)-(89/47308800),
(1/3080)*c(9)+(1/3960)*c(10)-(-4381/10218700800),
(1/4950)*c(11)+(1/4950)*c(12)-(-7/15206400),
(1/6930)*c(13)+(1/4620)*c(14)-(-13/94617600),
(1/4620)*c(15)+(1/3850)*c(16)-(-1/154828800),
(1/3300)*c(17)+(1/1320)*c(18)-(47/270336000),
(1/660)*c(19)+(1/2970)*c(20)-(-59/437944320),
c(1)*c(3)*c(5)*c(7)*c(9)-c(2)*c(4)*c(6)*c(8)*c(10),
c(11)*c(13)*c(15)*c(17)*c(19)-c(12)*c(14)*c(16)*c(18)*c(20),
c(1)^2+c(2)^2+c(3)^2+c(4)^2+c(5)^2+c(6)^2+c(7)^2+c(8)^2+c(9)^2+c(10)^2+c(11)^2+c(12)^2+c(13)^2+c(14)^2+c(15)^2+c(16)^2+c(17)^2+c(18)^2+c(19)^2+c(20)^2-(2670587/135895449600);
ideal B=std(I);
print("RAW_DIM|"+string(dim(B)));
print("RAW_VDIM|"+string(vdim(B)));
ideal R=std(radical(I));
int pointCount=vdim(R);
ring s=0,(c(1..20),zz),lp;
ideal J=imap(r,R);
J[size(J)+1]=zz-((1)*c(1)+(2)*c(2)+(4)*c(3)+(8)*c(4)+(16)*c(5)+(32)*c(6)+(64)*c(7)+(128)*c(8)+(256)*c(9)+(512)*c(10)+(1024)*c(11)+(2048)*c(12)+(4096)*c(13)+(8192)*c(14)+(16384)*c(15)+(32768)*c(16)+(65536)*c(17)+(131072)*c(18)+(262144)*c(19)+(524288)*c(20));
ideal G=std(J);
print("POINT_COUNT|"+string(pointCount));
print("BEGIN_BASIS");
print("DIM|"+string(dim(G)));
print("VDIM|"+string(vdim(G)));
int i; poly p;
for(i=1;i<=size(G);i++){
 print("POLY"); p=G[i];
 while(p!=0){ print("TERM|"+string(leadcoef(p))+"|"+string(leadexp(p))); p=p-lead(p); }
}
print("END_BASIS");
list FF=factorize(G[1]);
ideal factors=FF[1]; intvec powers=FF[2];
print("BEGIN_FACTORS");
for(i=1;i<=size(factors);i++){
 if(deg(factors[i])>0){
  print("FACTOR|"+string(powers[i])); p=factors[i];
  while(p!=0){ print("TERM|"+string(leadcoef(p))+"|"+string(leadexp(p))); p=p-lead(p); }
 }
}
print("END_FACTORS");
quit;
