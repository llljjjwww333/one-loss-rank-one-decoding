LIB "primdec.lib";
ring r=0,(c(1..24)),dp;
option(redSB);
ideal I=(1/390)*c(1)+(1/390)*c(6)+(1/1040)*c(7)+(1/910)*c(12)+(1/130)*c(13)+(1/780)*c(18)+(1/390)*c(19)+(1/520)*c(24)-(13/9289728),
(1/3510)*c(2)+(1/10530)*c(3)-(-1/97044480),
(1/10530)*c(4)+(1/3510)*c(5)-(7/258785280),
(1/7280)*c(8)+(1/7280)*c(9)-(-29/247726080),
(1/9360)*c(10)+(1/8190)*c(11)-(-199/1811496960),
(1/1040)*c(14)+(1/5200)*c(15)-(-1/7987200),
(1/3900)*c(16)+(1/4680)*c(17)-(-779/5175705600),
(1/780)*c(20)+(1/2340)*c(21)-(-1/4792320),
(1/10530)*c(22)+(1/4680)*c(23)-(-1/34504704),
(1/390)*c(1)+(1/3510)*c(2)-(209/388177920),
(1/10530)*c(3)+(1/10530)*c(4)-(-1/517570560),
(1/3510)*c(5)+(1/390)*c(6)-(47/64696320),
(1/1040)*c(7)+(1/7280)*c(8)-(-1/134184960),
(1/7280)*c(9)+(1/9360)*c(10)-(-6341/28983951360),
(1/8190)*c(11)+(1/910)*c(12)-(29/362299392),
(1/130)*c(13)+(1/1040)*c(14)-(31/92012544),
(1/5200)*c(15)+(1/3900)*c(16)-(-721/6900940800),
(1/4680)*c(17)+(1/780)*c(18)-(11/258785280),
(1/390)*c(19)+(1/780)*c(20)-(-7/9584640),
(1/2340)*c(21)+(1/10530)*c(22)-(11/34504704),
(1/4680)*c(23)+(1/520)*c(24)-(-7/23003136),
c(1)*c(3)*c(5)-c(2)*c(4)*c(6),
c(7)*c(9)*c(11)-c(8)*c(10)*c(12),
c(13)*c(15)*c(17)-c(14)*c(16)*c(18),
c(19)*c(21)*c(23)-c(20)*c(22)*c(24),
c(1)^2+c(2)^2+c(3)^2+c(4)^2+c(5)^2+c(6)^2+c(7)^2+c(8)^2+c(9)^2+c(10)^2+c(11)^2+c(12)^2+c(13)^2+c(14)^2+c(15)^2+c(16)^2+c(17)^2+c(18)^2+c(19)^2+c(20)^2+c(21)^2+c(22)^2+c(23)^2+c(24)^2-(643465/195689447424);
ideal B=std(I);
print("RAW_DIM|"+string(dim(B)));
print("RAW_VDIM|"+string(vdim(B)));
ideal R=std(radical(I));
int pointCount=vdim(R);
ring s=0,(c(1..24),zz),lp;
ideal J=imap(r,R);
J[size(J)+1]=zz-((1)*c(1)+(2)*c(2)+(4)*c(3)+(8)*c(4)+(16)*c(5)+(32)*c(6)+(64)*c(7)+(128)*c(8)+(256)*c(9)+(512)*c(10)+(1024)*c(11)+(2048)*c(12)+(4096)*c(13)+(8192)*c(14)+(16384)*c(15)+(32768)*c(16)+(65536)*c(17)+(131072)*c(18)+(262144)*c(19)+(524288)*c(20)+(1048576)*c(21)+(2097152)*c(22)+(4194304)*c(23)+(8388608)*c(24));
ideal G=std(J);
print("POINT_COUNT|"+string(pointCount));
print("BEGIN_BASIS");
print("DIM|"+string(dim(G)));
print("VDIM|"+string(vdim(G)));
int i; poly p;
for(i=1;i<=size(G);i++){
 print("POLY"); p=G[i];
 while(p!=0){ print("TERM|"+string(leadcoef(p))+"|"+string(leadexp(p))); p=p-lead(p); }
}
print("END_BASIS");
list FF=factorize(G[1]);
ideal factors=FF[1]; intvec powers=FF[2];
print("BEGIN_FACTORS");
for(i=1;i<=size(factors);i++){
 if(deg(factors[i])>0){
  print("FACTOR|"+string(powers[i])); p=factors[i];
  while(p!=0){ print("TERM|"+string(leadcoef(p))+"|"+string(leadexp(p))); p=p-lead(p); }
 }
}
print("END_FACTORS");
quit;
