LIB "primdec.lib";
ring r=0,(c(1..18)),dp;
option(redSB);
ideal I=(1/1680)*c(1)+(1/1120)*c(4)-(19/48168960),
(1/1200)*c(2)+(1/800)*c(3)+(1/3600)*c(5)+(1/1200)*c(10)-(-19/619315200),
(1/6480)*c(6)+(1/2880)*c(7)-(-143/209018880),
(1/2880)*c(8)+(1/2160)*c(9)+(1/720)*c(11)+(1/6480)*c(18)-(-247/79626240),
(1/720)*c(12)+(1/1440)*c(13)-(1/2064384),
(1/1440)*c(14)+(1/5040)*c(15)-(5/10838016),
(1/4480)*c(16)+(1/5760)*c(17)-(1/25690112),
(1/1680)*c(1)+(1/1200)*c(2)-(629/722534400),
(1/800)*c(3)+(1/1120)*c(4)-(-37/96337920),
(1/3600)*c(5)+(1/6480)*c(6)-(157/8360755200),
(1/2880)*c(7)+(1/2880)*c(8)-(-5/4128768),
(1/2160)*c(9)+(1/1200)*c(10)-(-793/1393459200),
(1/720)*c(11)+(1/720)*c(12)-(-1/1032192),
(1/1440)*c(13)+(1/1440)*c(14)-(-11/92897280),
(1/5040)*c(15)+(1/4480)*c(16)-(-19/5202247680),
(1/5760)*c(17)+(1/6480)*c(18)-(-107/1486356480),
c(1)*c(3)-c(2)*c(4),
c(5)*c(7)*c(9)-c(6)*c(8)*c(10),
c(11)*c(13)*c(15)*c(17)-c(12)*c(14)*c(16)*c(18),
c(1)^2+c(2)^2+c(3)^2+c(4)^2+c(5)^2+c(6)^2+c(7)^2+c(8)^2+c(9)^2+c(10)^2+c(11)^2+c(12)^2+c(13)^2+c(14)^2+c(15)^2+c(16)^2+c(17)^2+c(18)^2-(125425/9512681472);
ideal B=std(I);
print("RAW_DIM|"+string(dim(B)));
print("RAW_VDIM|"+string(vdim(B)));
ideal R=std(radical(I));
int pointCount=vdim(R);
ring s=0,(c(1..18),zz),lp;
ideal J=imap(r,R);
J[size(J)+1]=zz-((1)*c(1)+(2)*c(2)+(4)*c(3)+(8)*c(4)+(16)*c(5)+(32)*c(6)+(64)*c(7)+(128)*c(8)+(256)*c(9)+(512)*c(10)+(1024)*c(11)+(2048)*c(12)+(4096)*c(13)+(8192)*c(14)+(16384)*c(15)+(32768)*c(16)+(65536)*c(17)+(131072)*c(18));
ideal G=std(J);
print("POINT_COUNT|"+string(pointCount));
print("BEGIN_BASIS");
print("DIM|"+string(dim(G)));
print("VDIM|"+string(vdim(G)));
int i; poly p;
for(i=1;i<=size(G);i++){
 print("POLY"); p=G[i];
 while(p!=0){ print("TERM|"+string(leadcoef(p))+"|"+string(leadexp(p))); p=p-lead(p); }
}
print("END_BASIS");
list FF=factorize(G[1]);
ideal factors=FF[1]; intvec powers=FF[2];
print("BEGIN_FACTORS");
for(i=1;i<=size(factors);i++){
 if(deg(factors[i])>0){
  print("FACTOR|"+string(powers[i])); p=factors[i];
  while(p!=0){ print("TERM|"+string(leadcoef(p))+"|"+string(leadexp(p))); p=p-lead(p); }
 }
}
print("END_FACTORS");
quit;
