LIB "primdec.lib";
ring r=0,(c(1..20)),dp;
option(redSB);
ideal I=(1/900)*c(1)+(1/600)*c(4)-(-13/5971968),
(1/5400)*c(2)+(1/3600)*c(3)+(1/1800)*c(11)-(-11/3583180800),
(1/1200)*c(5)+(1/2400)*c(10)-(1/398131200),
(1/1200)*c(6)+(1/2800)*c(7)-(-1/12386304),
(1/3500)*c(8)+(1/3000)*c(9)+(1/3000)*c(20)-(-89/232243200),
(1/3000)*c(12)+(1/3500)*c(19)-(-1/387072000),
(1/3000)*c(13)+(1/4000)*c(14)-(-143/1327104000),
(1/4000)*c(15)+(1/3000)*c(16)-(533/663552000),
(1/4800)*c(17)+(1/5600)*c(18)-(667/1857945600),
(1/900)*c(1)+(1/5400)*c(2)-(121/895795200),
(1/3600)*c(3)+(1/600)*c(4)-(-2783/1194393600),
(1/1200)*c(5)+(1/1200)*c(6)+(1/1800)*c(11)-(-79/132710400),
(1/2800)*c(7)+(1/3500)*c(8)-(13/51609600),
(1/3000)*c(9)+(1/2400)*c(10)-(-19/79626240),
(1/3000)*c(12)+(1/3000)*c(13)+(1/3000)*c(20)-(1/18432000),
(1/4000)*c(14)+(1/4000)*c(15)-(1/88473600),
(1/3000)*c(16)+(1/4800)*c(17)-(353/265420800),
(1/5600)*c(18)+(1/3500)*c(19)-(-23/110592000),
c(1)*c(3)-c(2)*c(4),
c(5)*c(7)*c(9)-c(6)*c(8)*c(10),
c(12)*c(14)*c(16)*c(18)-c(13)*c(15)*c(17)*c(19),
c(1)^2+c(2)^2+c(3)^2+c(4)^2+c(5)^2+c(6)^2+c(7)^2+c(8)^2+c(9)^2+c(10)^2+c(11)^2+c(12)^2+c(13)^2+c(14)^2+c(15)^2+c(16)^2+c(17)^2+c(18)^2+c(19)^2+c(20)^2-(2138959/110075314176);
ideal B=std(I);
print("RAW_DIM|"+string(dim(B)));
print("RAW_VDIM|"+string(vdim(B)));
ideal R=std(radical(I));
int pointCount=vdim(R);
ring s=0,(c(1..20),zz),lp;
ideal J=imap(r,R);
J[size(J)+1]=zz-((1)*c(1)+(2)*c(2)+(4)*c(3)+(8)*c(4)+(16)*c(5)+(32)*c(6)+(64)*c(7)+(128)*c(8)+(256)*c(9)+(512)*c(10)+(1024)*c(11)+(2048)*c(12)+(4096)*c(13)+(8192)*c(14)+(16384)*c(15)+(32768)*c(16)+(65536)*c(17)+(131072)*c(18)+(262144)*c(19)+(524288)*c(20));
ideal G=std(J);
print("POINT_COUNT|"+string(pointCount));
print("BEGIN_BASIS");
print("DIM|"+string(dim(G)));
print("VDIM|"+string(vdim(G)));
int i; poly p;
for(i=1;i<=size(G);i++){
 print("POLY"); p=G[i];
 while(p!=0){ print("TERM|"+string(leadcoef(p))+"|"+string(leadexp(p))); p=p-lead(p); }
}
print("END_BASIS");
list FF=factorize(G[1]);
ideal factors=FF[1]; intvec powers=FF[2];
print("BEGIN_FACTORS");
for(i=1;i<=size(factors);i++){
 if(deg(factors[i])>0){
  print("FACTOR|"+string(powers[i])); p=factors[i];
  while(p!=0){ print("TERM|"+string(leadcoef(p))+"|"+string(leadexp(p))); p=p-lead(p); }
 }
}
print("END_FACTORS");
quit;
