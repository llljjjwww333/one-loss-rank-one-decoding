LIB "primdec.lib";
ring r=0,(c(1..18)),dp;
option(redSB);
ideal I=(1/3000)*c(1)+(1/4800)*c(4)-(73/63700992),
(1/2500)*c(2)+(1/4000)*c(3)-(-73/55296000),
(1/3200)*c(5)+(1/7200)*c(10)-(413/2388787200),
(1/2000)*c(6)+(1/1000)*c(7)-(7/7372800),
(1/600)*c(8)+(1/2700)*c(9)-(299/59719680),
(1/500)*c(11)+(1/1000)*c(18)-(-1/768000),
(1/700)*c(12)+(1/5600)*c(13)-(37/14745600),
(1/3200)*c(14)+(1/1600)*c(15)-(-29/13271040),
(1/3200)*c(16)+(1/1600)*c(17)-(-851/1061683200),
(1/3000)*c(1)+(1/2500)*c(2)-(-19/165888000),
(1/4000)*c(3)+(1/4800)*c(4)-(-19/318504960),
(1/3200)*c(5)+(1/2000)*c(6)-(-19/1327104000),
(1/1000)*c(7)+(1/600)*c(8)-(17/3072000),
(1/2700)*c(9)+(1/7200)*c(10)-(91/149299200),
(1/500)*c(11)+(1/700)*c(12)-(7/6912000),
(1/5600)*c(13)+(1/3200)*c(14)-(-17/35389440),
(1/1600)*c(15)+(1/3200)*c(16)-(-1/524288),
(1/1600)*c(17)+(1/1000)*c(18)-(-179/442368000),
c(1)*c(3)-c(2)*c(4),
c(5)*c(7)*c(9)-c(6)*c(8)*c(10),
c(11)*c(13)*c(15)*c(17)-c(12)*c(14)*c(16)*c(18),
c(1)^2+c(2)^2+c(3)^2+c(4)^2+c(5)^2+c(6)^2+c(7)^2+c(8)^2+c(9)^2+c(10)^2+c(11)^2+c(12)^2+c(13)^2+c(14)^2+c(15)^2+c(16)^2+c(17)^2+c(18)^2-(6766343/110075314176);
ideal B=std(I);
print("RAW_DIM|"+string(dim(B)));
print("RAW_VDIM|"+string(vdim(B)));
ideal R=std(radical(I));
int pointCount=vdim(R);
ring s=0,(c(1..18),zz),lp;
ideal J=imap(r,R);
J[size(J)+1]=zz-((1)*c(1)+(2)*c(2)+(4)*c(3)+(8)*c(4)+(16)*c(5)+(32)*c(6)+(64)*c(7)+(128)*c(8)+(256)*c(9)+(512)*c(10)+(1024)*c(11)+(2048)*c(12)+(4096)*c(13)+(8192)*c(14)+(16384)*c(15)+(32768)*c(16)+(65536)*c(17)+(131072)*c(18));
ideal G=std(J);
print("POINT_COUNT|"+string(pointCount));
print("BEGIN_BASIS");
print("DIM|"+string(dim(G)));
print("VDIM|"+string(vdim(G)));
int i; poly p;
for(i=1;i<=size(G);i++){
 print("POLY"); p=G[i];
 while(p!=0){ print("TERM|"+string(leadcoef(p))+"|"+string(leadexp(p))); p=p-lead(p); }
}
print("END_BASIS");
list FF=factorize(G[1]);
ideal factors=FF[1]; intvec powers=FF[2];
print("BEGIN_FACTORS");
for(i=1;i<=size(factors);i++){
 if(deg(factors[i])>0){
  print("FACTOR|"+string(powers[i])); p=factors[i];
  while(p!=0){ print("TERM|"+string(leadcoef(p))+"|"+string(leadexp(p))); p=p-lead(p); }
 }
}
print("END_FACTORS");
quit;
