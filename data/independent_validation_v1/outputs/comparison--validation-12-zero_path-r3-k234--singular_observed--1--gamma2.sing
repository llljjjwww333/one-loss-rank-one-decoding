LIB "primdec.lib";
ring r=0,(c(1..24)),dp;
option(redSB);
ideal I=(1/720)*c(1)+(1/432)*c(4)-(4619/1070530560),
(1/2160)*c(2)+(1/1296)*c(3)+(1/3456)*c(11)-(-149/118947840),
(1/1728)*c(5)+(1/2304)*c(10)-(-67/190316544),
(1/864)*c(6)+(1/576)*c(7)-(235/285474816),
(1/5184)*c(8)+(1/10368)*c(9)+(1/7776)*c(22)-(-7/160579584),
(1/8064)*c(12)+(1/6048)*c(13)-(0),
(1/864)*c(14)+(1/3456)*c(21)-(-19/214106112),
(1/2304)*c(15)+(1/6912)*c(16)-(85/856424448),
(1/6048)*c(17)+(1/2016)*c(18)-(-13/249790464),
(1/576)*c(19)+(1/2304)*c(20)-(31/570949632),
(1/3456)*c(23)+(1/1152)*c(24)-(0),
(1/720)*c(1)+(1/2160)*c(2)-(23/16220160),
(1/1296)*c(3)+(1/432)*c(4)-(1/608256),
(1/1728)*c(5)+(1/864)*c(6)+(1/6048)*c(13)-(-221/285474816),
(1/576)*c(7)+(1/5184)*c(8)-(1/743424),
(1/10368)*c(9)+(1/2304)*c(10)-(-67/467140608),
(1/3456)*c(11)+(1/8064)*c(12)-(0),
(1/864)*c(14)+(1/2304)*c(15)+(1/1152)*c(24)-(49/428212224),
(1/6912)*c(16)+(1/6048)*c(17)-(-1475/5994971136),
(1/2016)*c(18)+(1/576)*c(19)-(-193/499580928),
(1/2304)*c(20)+(1/3456)*c(21)-(101/190316544),
(1/7776)*c(22)+(1/3456)*c(23)-(0),
c(1)*c(3)-c(2)*c(4),
c(5)*c(7)*c(9)-c(6)*c(8)*c(10),
c(14)*c(16)*c(18)*c(20)-c(15)*c(17)*c(19)*c(21),
c(1)^2+c(2)^2+c(3)^2+c(4)^2+c(5)^2+c(6)^2+c(7)^2+c(8)^2+c(9)^2+c(10)^2+c(11)^2+c(12)^2+c(13)^2+c(14)^2+c(15)^2+c(16)^2+c(17)^2+c(18)^2+c(19)^2+c(20)^2+c(21)^2+c(22)^2+c(23)^2+c(24)^2-(1216757/122817609728);
ideal B=std(I);
print("RAW_DIM|"+string(dim(B)));
print("RAW_VDIM|"+string(vdim(B)));
ideal R=std(radical(I));
int pointCount=vdim(R);
ring s=0,(c(1..24),zz),lp;
ideal J=imap(r,R);
J[size(J)+1]=zz-((1)*c(1)+(2)*c(2)+(4)*c(3)+(8)*c(4)+(16)*c(5)+(32)*c(6)+(64)*c(7)+(128)*c(8)+(256)*c(9)+(512)*c(10)+(1024)*c(11)+(2048)*c(12)+(4096)*c(13)+(8192)*c(14)+(16384)*c(15)+(32768)*c(16)+(65536)*c(17)+(131072)*c(18)+(262144)*c(19)+(524288)*c(20)+(1048576)*c(21)+(2097152)*c(22)+(4194304)*c(23)+(8388608)*c(24));
ideal G=std(J);
print("POINT_COUNT|"+string(pointCount));
print("BEGIN_BASIS");
print("DIM|"+string(dim(G)));
print("VDIM|"+string(vdim(G)));
int i; poly p;
for(i=1;i<=size(G);i++){
 print("POLY"); p=G[i];
 while(p!=0){ print("TERM|"+string(leadcoef(p))+"|"+string(leadexp(p))); p=p-lead(p); }
}
print("END_BASIS");
list FF=factorize(G[1]);
ideal factors=FF[1]; intvec powers=FF[2];
print("BEGIN_FACTORS");
for(i=1;i<=size(factors);i++){
 if(deg(factors[i])>0){
  print("FACTOR|"+string(powers[i])); p=factors[i];
  while(p!=0){ print("TERM|"+string(leadcoef(p))+"|"+string(leadexp(p))); p=p-lead(p); }
 }
}
print("END_FACTORS");
quit;
