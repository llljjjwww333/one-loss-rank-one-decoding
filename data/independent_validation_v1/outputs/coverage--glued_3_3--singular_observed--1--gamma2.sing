LIB "primdec.lib";
ring r=0,(c(1..18)),dp;
option(redSB);
ideal I=(1/336)*c(1)+(1/1176)*c(4)+(1/336)*c(7)+(1/1008)*c(10)+(1/1176)*c(13)+(1/336)*c(16)-(-167/130394880),
(1/448)*c(2)+(1/1344)*c(3)-(-1/4730880),
(1/1568)*c(5)+(1/1344)*c(6)-(-19/57953280),
(1/560)*c(8)+(1/1680)*c(9)-(13/11289600),
(1/2688)*c(11)+(1/1792)*c(12)-(1/5519360),
(1/3136)*c(14)+(1/1792)*c(15)-(333/154542080),
(1/336)*c(17)+(1/672)*c(18)-(19/2069760),
(1/1344)*c(3)+(1/1344)*c(6)+(1/1680)*c(9)-(-59/248371200),
(1/336)*c(1)+(1/448)*c(2)-(-17/33116160),
(1/1176)*c(4)+(1/1568)*c(5)-(-1/8692992),
(1/336)*c(7)+(1/560)*c(8)-(23/24837120),
(1/1792)*c(12)+(1/1792)*c(15)+(1/672)*c(18)-(-169/66232320),
(1/1008)*c(10)+(1/2688)*c(11)-(-1/1216512),
(1/1176)*c(13)+(1/3136)*c(14)-(97/86929920),
(1/336)*c(16)+(1/336)*c(17)-(9/689920),
c(1)*c(3)*c(5)-c(2)*c(6)*c(4),
c(1)*c(3)*c(8)-c(2)*c(9)*c(7),
c(4)*c(6)*c(8)-c(5)*c(9)*c(7),
c(10)*c(12)*c(14)-c(11)*c(15)*c(13),
c(10)*c(12)*c(17)-c(11)*c(18)*c(16),
c(13)*c(15)*c(17)-c(14)*c(18)*c(16),
c(1)^2+c(2)^2+c(3)^2+c(4)^2+c(5)^2+c(6)^2+c(7)^2+c(8)^2+c(9)^2+c(10)^2+c(11)^2+c(12)^2+c(13)^2+c(14)^2+c(15)^2+c(16)^2+c(17)^2+c(18)^2-(9157/182138880);
ideal B=std(I);
print("RAW_DIM|"+string(dim(B)));
print("RAW_VDIM|"+string(vdim(B)));
ideal R=std(radical(I));
int pointCount=vdim(R);
ring s=0,(c(1..18),zz),lp;
ideal J=imap(r,R);
J[size(J)+1]=zz-((1)*c(1)+(2)*c(2)+(4)*c(3)+(8)*c(4)+(16)*c(5)+(32)*c(6)+(64)*c(7)+(128)*c(8)+(256)*c(9)+(512)*c(10)+(1024)*c(11)+(2048)*c(12)+(4096)*c(13)+(8192)*c(14)+(16384)*c(15)+(32768)*c(16)+(65536)*c(17)+(131072)*c(18));
ideal G=std(J);
print("POINT_COUNT|"+string(pointCount));
print("BEGIN_BASIS");
print("DIM|"+string(dim(G)));
print("VDIM|"+string(vdim(G)));
int i; poly p;
for(i=1;i<=size(G);i++){
 print("POLY"); p=G[i];
 while(p!=0){ print("TERM|"+string(leadcoef(p))+"|"+string(leadexp(p))); p=p-lead(p); }
}
print("END_BASIS");
list FF=factorize(G[1]);
ideal factors=FF[1]; intvec powers=FF[2];
print("BEGIN_FACTORS");
for(i=1;i<=size(factors);i++){
 if(deg(factors[i])>0){
  print("FACTOR|"+string(powers[i])); p=factors[i];
  while(p!=0){ print("TERM|"+string(leadcoef(p))+"|"+string(leadexp(p))); p=p-lead(p); }
 }
}
print("END_FACTORS");
quit;
