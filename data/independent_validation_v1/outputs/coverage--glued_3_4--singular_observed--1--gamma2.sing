LIB "primdec.lib";
ring r=0,(c(1..21)),dp;
option(redSB);
ideal I=(1/1512)*c(1)+(1/432)*c(4)+(1/1512)*c(7)+(1/1728)*c(10)+(1/432)*c(13)+(1/648)*c(16)+(1/216)*c(19)-(205/271724544),
(1/3024)*c(2)+(1/1728)*c(3)-(1/271724544),
(1/432)*c(5)+(1/864)*c(6)-(-5/9704448),
(1/1008)*c(8)+(1/576)*c(9)-(11/90574848),
(1/3456)*c(11)+(1/2160)*c(12)-(1/9953280),
(1/432)*c(14)+(1/1080)*c(15)-(1/207360),
(1/432)*c(17)+(1/720)*c(18)-(19/5391360),
(1/360)*c(20)+(1/1800)*c(21)-(-119/10108800),
(1/1728)*c(3)+(1/864)*c(6)+(1/576)*c(9)-(-7/19408896),
(1/1512)*c(1)+(1/3024)*c(2)-(-1/19408896),
(1/432)*c(4)+(1/432)*c(5)-(-1/3639168),
(1/1512)*c(7)+(1/1008)*c(8)-(145/407586816),
(1/2160)*c(12)+(1/1080)*c(15)+(1/720)*c(18)+(1/1800)*c(21)-(-43/20217600),
(1/1728)*c(10)+(1/3456)*c(11)-(-77/232906752),
(1/432)*c(13)+(1/432)*c(14)-(29/7278336),
(1/648)*c(16)+(1/432)*c(17)-(55/9704448),
(1/216)*c(19)+(1/360)*c(20)-(-11/1119744),
c(1)*c(3)*c(5)-c(2)*c(6)*c(4),
c(1)*c(3)*c(8)-c(2)*c(9)*c(7),
c(4)*c(6)*c(8)-c(5)*c(9)*c(7),
c(10)*c(12)*c(14)-c(11)*c(15)*c(13),
c(10)*c(12)*c(17)-c(11)*c(18)*c(16),
c(10)*c(12)*c(20)-c(11)*c(21)*c(19),
c(13)*c(15)*c(17)-c(14)*c(18)*c(16),
c(13)*c(15)*c(20)-c(14)*c(21)*c(19),
c(16)*c(18)*c(20)-c(17)*c(21)*c(19),
c(1)^2+c(2)^2+c(3)^2+c(4)^2+c(5)^2+c(6)^2+c(7)^2+c(8)^2+c(9)^2+c(10)^2+c(11)^2+c(12)^2+c(13)^2+c(14)^2+c(15)^2+c(16)^2+c(17)^2+c(18)^2+c(19)^2+c(20)^2+c(21)^2-(314423/9083363328);
ideal B=std(I);
print("RAW_DIM|"+string(dim(B)));
print("RAW_VDIM|"+string(vdim(B)));
ideal R=std(radical(I));
int pointCount=vdim(R);
ring s=0,(c(1..21),zz),lp;
ideal J=imap(r,R);
J[size(J)+1]=zz-((1)*c(1)+(2)*c(2)+(4)*c(3)+(8)*c(4)+(16)*c(5)+(32)*c(6)+(64)*c(7)+(128)*c(8)+(256)*c(9)+(512)*c(10)+(1024)*c(11)+(2048)*c(12)+(4096)*c(13)+(8192)*c(14)+(16384)*c(15)+(32768)*c(16)+(65536)*c(17)+(131072)*c(18)+(262144)*c(19)+(524288)*c(20)+(1048576)*c(21));
ideal G=std(J);
print("POINT_COUNT|"+string(pointCount));
print("BEGIN_BASIS");
print("DIM|"+string(dim(G)));
print("VDIM|"+string(vdim(G)));
int i; poly p;
for(i=1;i<=size(G);i++){
 print("POLY"); p=G[i];
 while(p!=0){ print("TERM|"+string(leadcoef(p))+"|"+string(leadexp(p))); p=p-lead(p); }
}
print("END_BASIS");
list FF=factorize(G[1]);
ideal factors=FF[1]; intvec powers=FF[2];
print("BEGIN_FACTORS");
for(i=1;i<=size(factors);i++){
 if(deg(factors[i])>0){
  print("FACTOR|"+string(powers[i])); p=factors[i];
  while(p!=0){ print("TERM|"+string(leadcoef(p))+"|"+string(leadexp(p))); p=p-lead(p); }
 }
}
print("END_FACTORS");
quit;
