LIB "primdec.lib";
ring r=0,(c(1..9)),dp;
option(redSB);
ideal I=(1/5472)*c(1)+(1/7904)*c(4)+(1/3952)*c(7)-(-31/58426368),
(1/6912)*c(2)+(1/2304)*c(3)-(1/3784704),
(1/8736)*c(5)+(1/2016)*c(6)-(-19/10762752),
(1/832)*c(8)+(1/384)*c(9)-(1/559104),
(1/2304)*c(3)+(1/2016)*c(6)+(1/384)*c(9)-(-163/13246464),
(1/5472)*c(1)+(1/6912)*c(2)-(-5/10272768),
(1/7904)*c(4)+(1/8736)*c(5)-(-3/8520512),
(1/3952)*c(7)+(1/832)*c(8)-(1005/77901824),
c(1)*c(3)*c(5)-c(2)*c(6)*c(4),
c(1)*c(3)*c(8)-c(2)*c(9)*c(7),
c(4)*c(6)*c(8)-c(5)*c(9)*c(7),
c(1)^2+c(2)^2+c(3)^2+c(4)^2+c(5)^2+c(6)^2+c(7)^2+c(8)^2+c(9)^2-(2273/12142592);
ideal B=std(I);
print("RAW_DIM|"+string(dim(B)));
print("RAW_VDIM|"+string(vdim(B)));
ideal R=std(radical(I));
int pointCount=vdim(R);
ring s=0,(c(1..9),zz),lp;
ideal J=imap(r,R);
J[size(J)+1]=zz-((1)*c(1)+(2)*c(2)+(4)*c(3)+(8)*c(4)+(16)*c(5)+(32)*c(6)+(64)*c(7)+(128)*c(8)+(256)*c(9));
ideal G=std(J);
print("POINT_COUNT|"+string(pointCount));
print("BEGIN_BASIS");
print("DIM|"+string(dim(G)));
print("VDIM|"+string(vdim(G)));
int i; poly p;
for(i=1;i<=size(G);i++){
 print("POLY"); p=G[i];
 while(p!=0){ print("TERM|"+string(leadcoef(p))+"|"+string(leadexp(p))); p=p-lead(p); }
}
print("END_BASIS");
list FF=factorize(G[1]);
ideal factors=FF[1]; intvec powers=FF[2];
print("BEGIN_FACTORS");
for(i=1;i<=size(factors);i++){
 if(deg(factors[i])>0){
  print("FACTOR|"+string(powers[i])); p=factors[i];
  while(p!=0){ print("TERM|"+string(leadcoef(p))+"|"+string(leadexp(p))); p=p-lead(p); }
 }
}
print("END_FACTORS");
quit;
