LIB "primdec.lib";
ring r=0,(c(1..9)),dp;
option(redSB);
ideal I=(1/4032)*c(1)+(1/6048)*c(4)+(1/10752)*c(7)-(-1/7225344),
(1/1152)*c(2)+(1/384)*c(3)-(-5/387072),
(1/7776)*c(5)+(1/1728)*c(6)-(1/3483648),
(1/11776)*c(8)+(1/1472)*c(9)-(-1/565248),
(1/384)*c(3)+(1/1728)*c(6)+(1/1472)*c(9)-(-17/1907712),
(1/4032)*c(1)+(1/1152)*c(2)-(-1/225792),
(1/6048)*c(4)+(1/7776)*c(5)-(-1/762048),
(1/10752)*c(7)+(1/11776)*c(8)-(19/166182912),
c(1)*c(3)*c(5)-c(2)*c(6)*c(4),
c(1)*c(3)*c(8)-c(2)*c(9)*c(7),
c(4)*c(6)*c(8)-c(5)*c(9)*c(7),
c(1)^2+c(2)^2+c(3)^2+c(4)^2+c(5)^2+c(6)^2+c(7)^2+c(8)^2+c(9)^2-(13/112896);
ideal B=std(I);
print("RAW_DIM|"+string(dim(B)));
print("RAW_VDIM|"+string(vdim(B)));
ideal R=std(radical(I));
int pointCount=vdim(R);
ring s=0,(c(1..9),zz),lp;
ideal J=imap(r,R);
J[size(J)+1]=zz-((1)*c(1)+(2)*c(2)+(4)*c(3)+(8)*c(4)+(16)*c(5)+(32)*c(6)+(64)*c(7)+(128)*c(8)+(256)*c(9));
ideal G=std(J);
print("POINT_COUNT|"+string(pointCount));
print("BEGIN_BASIS");
print("DIM|"+string(dim(G)));
print("VDIM|"+string(vdim(G)));
int i; poly p;
for(i=1;i<=size(G);i++){
 print("POLY"); p=G[i];
 while(p!=0){ print("TERM|"+string(leadcoef(p))+"|"+string(leadexp(p))); p=p-lead(p); }
}
print("END_BASIS");
list FF=factorize(G[1]);
ideal factors=FF[1]; intvec powers=FF[2];
print("BEGIN_FACTORS");
for(i=1;i<=size(factors);i++){
 if(deg(factors[i])>0){
  print("FACTOR|"+string(powers[i])); p=factors[i];
  while(p!=0){ print("TERM|"+string(leadcoef(p))+"|"+string(leadexp(p))); p=p-lead(p); }
 }
}
print("END_FACTORS");
quit;
