LIB "primdec.lib";
ring r=0,(c(1..9)),dp;
option(redSB);
ideal I=(1/144)*c(1)+(1/672)*c(4)+(1/960)*c(7)-(227/11289600),
(1/1392)*c(2)+(1/2784)*c(3)-(1/311808),
(1/6720)*c(5)+(1/2880)*c(6)-(1/470400),
(1/4800)*c(8)+(1/1440)*c(9)-(11/8064000),
(1/2784)*c(3)+(1/2880)*c(6)+(1/1440)*c(9)-(41/18708480),
(1/144)*c(1)+(1/1392)*c(2)-(1/66816),
(1/672)*c(4)+(1/6720)*c(5)-(13/2508800),
(1/960)*c(7)+(1/4800)*c(8)-(1/224000),
c(1)*c(3)*c(5)-c(2)*c(6)*c(4),
c(1)*c(3)*c(8)-c(2)*c(9)*c(7),
c(4)*c(6)*c(8)-c(5)*c(9)*c(7),
c(1)^2+c(2)^2+c(3)^2+c(4)^2+c(5)^2+c(6)^2+c(7)^2+c(8)^2+c(9)^2-(39/313600);
ideal B=std(I);
print("RAW_DIM|"+string(dim(B)));
print("RAW_VDIM|"+string(vdim(B)));
ideal R=std(radical(I));
int pointCount=vdim(R);
ring s=0,(c(1..9),zz),lp;
ideal J=imap(r,R);
J[size(J)+1]=zz-((1)*c(1)+(2)*c(2)+(4)*c(3)+(8)*c(4)+(16)*c(5)+(32)*c(6)+(64)*c(7)+(128)*c(8)+(256)*c(9));
ideal G=std(J);
print("POINT_COUNT|"+string(pointCount));
print("BEGIN_BASIS");
print("DIM|"+string(dim(G)));
print("VDIM|"+string(vdim(G)));
int i; poly p;
for(i=1;i<=size(G);i++){
 print("POLY"); p=G[i];
 while(p!=0){ print("TERM|"+string(leadcoef(p))+"|"+string(leadexp(p))); p=p-lead(p); }
}
print("END_BASIS");
list FF=factorize(G[1]);
ideal factors=FF[1]; intvec powers=FF[2];
print("BEGIN_FACTORS");
for(i=1;i<=size(factors);i++){
 if(deg(factors[i])>0){
  print("FACTOR|"+string(powers[i])); p=factors[i];
  while(p!=0){ print("TERM|"+string(leadcoef(p))+"|"+string(leadexp(p))); p=p-lead(p); }
 }
}
print("END_FACTORS");
quit;
