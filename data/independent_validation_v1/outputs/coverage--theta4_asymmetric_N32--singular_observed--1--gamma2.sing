LIB "primdec.lib";
ring r=0,(c(1..12)),dp;
option(redSB);
ideal I=(1/1700)*c(1)+(1/5100)*c(4)+(1/2975)*c(7)+(1/11900)*c(10)-(-11/32640000),
(1/2300)*c(2)+(1/4025)*c(3)-(-39/206080000),
(1/9600)*c(5)+(1/5600)*c(6)-(-13/35840000),
(1/2100)*c(8)+(1/2100)*c(9)-(11/8960000),
(1/18900)*c(11)+(1/4725)*c(12)-(1/960000),
(1/4025)*c(3)+(1/5600)*c(6)+(1/2100)*c(9)+(1/4725)*c(12)-(-113/412160000),
(1/1700)*c(1)+(1/2300)*c(2)-(-291/500480000),
(1/5100)*c(4)+(1/9600)*c(5)-(-19/261120000),
(1/2975)*c(7)+(1/2100)*c(8)-(163/91392000),
(1/11900)*c(10)+(1/18900)*c(11)-(1/1904000),
c(1)*c(3)*c(5)-c(2)*c(6)*c(4),
c(1)*c(3)*c(8)-c(2)*c(9)*c(7),
c(1)*c(3)*c(11)-c(2)*c(12)*c(10),
c(4)*c(6)*c(8)-c(5)*c(9)*c(7),
c(4)*c(6)*c(11)-c(5)*c(12)*c(10),
c(7)*c(9)*c(11)-c(8)*c(12)*c(10),
c(1)^2+c(2)^2+c(3)^2+c(4)^2+c(5)^2+c(6)^2+c(7)^2+c(8)^2+c(9)^2+c(10)^2+c(11)^2+c(12)^2-(353/3276800);
ideal B=std(I);
print("RAW_DIM|"+string(dim(B)));
print("RAW_VDIM|"+string(vdim(B)));
ideal R=std(radical(I));
int pointCount=vdim(R);
ring s=0,(c(1..12),zz),lp;
ideal J=imap(r,R);
J[size(J)+1]=zz-((1)*c(1)+(2)*c(2)+(4)*c(3)+(8)*c(4)+(16)*c(5)+(32)*c(6)+(64)*c(7)+(128)*c(8)+(256)*c(9)+(512)*c(10)+(1024)*c(11)+(2048)*c(12));
ideal G=std(J);
print("POINT_COUNT|"+string(pointCount));
print("BEGIN_BASIS");
print("DIM|"+string(dim(G)));
print("VDIM|"+string(vdim(G)));
int i; poly p;
for(i=1;i<=size(G);i++){
 print("POLY"); p=G[i];
 while(p!=0){ print("TERM|"+string(leadcoef(p))+"|"+string(leadexp(p))); p=p-lead(p); }
}
print("END_BASIS");
list FF=factorize(G[1]);
ideal factors=FF[1]; intvec powers=FF[2];
print("BEGIN_FACTORS");
for(i=1;i<=size(factors);i++){
 if(deg(factors[i])>0){
  print("FACTOR|"+string(powers[i])); p=factors[i];
  while(p!=0){ print("TERM|"+string(leadcoef(p))+"|"+string(leadexp(p))); p=p-lead(p); }
 }
}
print("END_FACTORS");
quit;
