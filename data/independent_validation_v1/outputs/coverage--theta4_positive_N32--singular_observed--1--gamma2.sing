LIB "primdec.lib";
ring r=0,(c(1..12)),dp;
option(redSB);
ideal I=(1/11050)*c(1)+(1/6500)*c(4)+(1/7150)*c(7)+(1/14950)*c(10)-(35473/44283096000),
(1/5100)*c(2)+(1/2100)*c(3)-(31/28274400),
(1/750)*c(5)+(1/525)*c(6)-(31/2772000),
(1/2750)*c(8)+(1/1750)*c(9)-(13/10164000),
(1/8625)*c(11)+(1/2625)*c(12)-(1/1593900),
(1/2100)*c(3)+(1/525)*c(6)+(1/1750)*c(9)+(1/2625)*c(12)-(1/198000),
(1/11050)*c(1)+(1/5100)*c(2)-(1/1640925),
(1/6500)*c(4)+(1/750)*c(5)-(9/1144000),
(1/7150)*c(7)+(1/2750)*c(8)-(1/786500),
(1/14950)*c(10)+(1/8625)*c(11)-(67/355212000),
c(1)*c(3)*c(5)-c(2)*c(6)*c(4),
c(1)*c(3)*c(8)-c(2)*c(9)*c(7),
c(1)*c(3)*c(11)-c(2)*c(12)*c(10),
c(4)*c(6)*c(8)-c(5)*c(9)*c(7),
c(4)*c(6)*c(11)-c(5)*c(12)*c(10),
c(7)*c(9)*c(11)-c(8)*c(12)*c(10),
c(1)^2+c(2)^2+c(3)^2+c(4)^2+c(5)^2+c(6)^2+c(7)^2+c(8)^2+c(9)^2+c(10)^2+c(11)^2+c(12)^2-(5/76032);
ideal B=std(I);
print("RAW_DIM|"+string(dim(B)));
print("RAW_VDIM|"+string(vdim(B)));
ideal R=std(radical(I));
int pointCount=vdim(R);
ring s=0,(c(1..12),zz),lp;
ideal J=imap(r,R);
J[size(J)+1]=zz-((1)*c(1)+(2)*c(2)+(4)*c(3)+(8)*c(4)+(16)*c(5)+(32)*c(6)+(64)*c(7)+(128)*c(8)+(256)*c(9)+(512)*c(10)+(1024)*c(11)+(2048)*c(12));
ideal G=std(J);
print("POINT_COUNT|"+string(pointCount));
print("BEGIN_BASIS");
print("DIM|"+string(dim(G)));
print("VDIM|"+string(vdim(G)));
int i; poly p;
for(i=1;i<=size(G);i++){
 print("POLY"); p=G[i];
 while(p!=0){ print("TERM|"+string(leadcoef(p))+"|"+string(leadexp(p))); p=p-lead(p); }
}
print("END_BASIS");
list FF=factorize(G[1]);
ideal factors=FF[1]; intvec powers=FF[2];
print("BEGIN_FACTORS");
for(i=1;i<=size(factors);i++){
 if(deg(factors[i])>0){
  print("FACTOR|"+string(powers[i])); p=factors[i];
  while(p!=0){ print("TERM|"+string(leadcoef(p))+"|"+string(leadexp(p))); p=p-lead(p); }
 }
}
print("END_FACTORS");
quit;
